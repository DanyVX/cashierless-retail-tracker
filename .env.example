# Copy to .env for local use. Never commit .env.
CRT_BLUR_FACES=true
CRT_REQUIRE_CONSENT=true
# Raw frame storage is disabled until encrypted storage and erase controls exist.
CRT_STORE_RAW_FRAMES=false
CRT_RETENTION_SECONDS=0
CRT_LOG_FORMAT=json
# Consent is confirmed for each recording externally, not via a permanent ID.
# A local flag does not substitute for written consent.
